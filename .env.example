# Aplikasi
NODE_ENV=development
PORT=3000

# PostgreSQL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/goodeva_desk?schema=public"

# Redis
REDIS_ENABLED=true
REDIS_URL="redis://localhost:6379"
CACHE_TTL_SECONDS=604800
CACHE_SIMILARITY_THRESHOLD=0.85
CACHE_SIMILARITY_MAX_ENTRIES=100

# Helper Python NLP (opsional)
GOODEVA_API_KEY=demo-org-key
GOODEVA_API_URL=http://localhost:3000

# LLM (OpenAI Chat Completions)
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL="https://api.openai.com/v1"
LLM_TIMEOUT_MS=10000
LLM_MAX_RETRIES=1
